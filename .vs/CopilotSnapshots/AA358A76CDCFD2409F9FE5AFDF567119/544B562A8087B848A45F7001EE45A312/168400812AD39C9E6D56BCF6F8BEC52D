        private void EnqueueImage(IInsImage image)
        {
            if (image == null)
                return;

            lock (_imageQueueLock)
            {
                EnqueueImage(image);
                int maxCount = Math.Max(1, _bufferCount);
                while (_imageList.Count > maxCount)
                    _imageList.TryDequeue(out IInsImage discardedImage);
            }
        }

        private void ClearImageQueue()
        {
            lock (_imageQueueLock)
            {
                while (_imageList.TryDequeue(out IInsImage discardedImage))
                {
                }
            }
        }

