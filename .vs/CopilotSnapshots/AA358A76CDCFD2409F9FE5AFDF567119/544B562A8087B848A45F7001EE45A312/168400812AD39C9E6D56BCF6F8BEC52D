            }
        }
        public bool SetTriggerMode(Ins2DCamTriggerMode mode)
        {
            int ret = 0;
            if (mode == Ins2DCamTriggerMode.Software)
            {
                ret += m_MyCamera.MV_CC_SetEnumValue_NET("TriggerSource", (uint)7);
                if (ret == 0)
                {
                    triggerMode = Ins2DCamTriggerMode.Software;
                }
            }
            else
            {
                //ret += m_MyCamera.MV_CC_SetEnumValue_NET("TriggerSource", (uint)1);
                if (mode == Ins2DCamTriggerMode.HardwareRisingEdge)
                {
                    ret += m_MyCamera.MV_CC_SetEnumValue_NET("TriggerActivation", (uint)0);
                    if (ret == 0)
                    {
                        triggerMode = Ins2DCamTriggerMode.HardwareRisingEdge;
                    }
                }
                else if (mode == Ins2DCamTriggerMode.HardwareFallingEdge)
                {
                    ret += m_MyCamera.MV_CC_SetEnumValue_NET("TriggerActivation", (uint)1);
                    if (ret == 0)
                    {
                        triggerMode = Ins2DCamTriggerMode.HardwareFallingEdge;
                    }
                }
                else if (mode == Ins2DCamTriggerMode.HardwareLevelHigh)
                {
                    ret += m_MyCamera.MV_CC_SetEnumValue_NET("TriggerActivation", (uint)2);
                    if (ret == 0)
                    {
                        triggerMode = Ins2DCamTriggerMode.HardwareLevelHigh;
                    }
                }
                else if (mode == Ins2DCamTriggerMode.HardwareLevelLow)
                {
                    ret += m_MyCamera.MV_CC_SetEnumValue_NET("TriggerActivation", (uint)3);
                    if (ret == 0)
                    {
                        triggerMode = Ins2DCamTriggerMode.HardwareLevelLow;
                    }
                }
                else if (mode == Ins2DCamTriggerMode.HardwareAnyEdge)
                {
                    ret += m_MyCamera.MV_CC_SetEnumValue_NET("TriggerActivation", (uint)4);
                    if (ret == 0)
                    {
                        triggerMode = Ins2DCamTriggerMode.HardwareAnyEdge;
                    }
                }
            }

            if (ret == 0)
            {
                return true;
            }
            else
            {
                return false;
            }
        }

