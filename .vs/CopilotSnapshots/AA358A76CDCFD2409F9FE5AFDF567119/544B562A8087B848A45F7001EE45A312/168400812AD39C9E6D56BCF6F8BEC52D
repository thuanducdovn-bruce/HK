        public void SetParams()
        {
            int nRet = MyCamera.MV_OK;

            if (_isLive == false)
            {
                //取像模式
                switch (_acquisitionMode)
                {
                    case InsAcquisitionModeEnum.SingleFrame:
                        {
                            nRet = m_MyCamera.MV_CC_SetEnumValue_NET("AcquisitionMode", (uint)MyCamera.MV_CAM_ACQUISITION_MODE.MV_ACQ_MODE_SINGLE);
                            if (nRet != MyCamera.MV_OK)
                            {
                                //m_MyCamera.MV_CC_DestroyDevice_NET();
                                _errMessage = "设置相机:" + Name + " 取像模式为单次采集失败";
                                return;
                            }
                            break;
                        }
                    case InsAcquisitionModeEnum.Continuous:
                        {
                            nRet = m_MyCamera.MV_CC_SetEnumValue_NET("AcquisitionMode", 0);
                            if (nRet != MyCamera.MV_OK)
                            {
                                // m_MyCamera.MV_CC_DestroyDevice_NET();
                                _errMessage = "设置相机:" + Name + " 取像模式为连续采集失败";
                                return;
                            }
                            break;
                        }
                }

                //触发模式
                if (_isTriggerOn)
                {


                    nRet = m_MyCamera.MV_CC_SetEnumValue_NET("TriggerMode", (uint)1);
                    if (nRet != MyCamera.MV_OK)
                    {
                        //m_MyCamera.MV_CC_DestroyDevice_NET();
                        _errMessage = "设置相机:" + Name + " 触发模式打开失败";
                        return;
                    }

                }
                else
                {

                    nRet = m_MyCamera.MV_CC_SetEnumValue_NET("TriggerMode", (uint)0);
                    if (nRet != MyCamera.MV_OK)
                    {
                        // m_MyCamera.MV_CC_DestroyDevice_NET();
                        _errMessage = "设置相机:" + Name + " 触发模式关闭失败";
                        return;
                    }

                }
                SetTriggerMode(triggerMode);
                //图像格式
                switch (_imageFormat)
                {
                    case InsImageType.Grey8:
                        {
                            nRet = m_MyCamera.MV_CC_SetEnumValue_NET("PixelFormat", Convert.ToUInt32(MyCamera.MvGvspPixelType.PixelType_Gvsp_Mono8));

                            if (MyCamera.MV_OK != nRet)
                            {
                                //m_MyCamera.MV_CC_DestroyDevice_NET();
                                _errMessage = "设置相机:" + Name + " 黑白图像格式失败";
                                return;
                            }
                            break;
                        }

                    case InsImageType.Color24:
                        {
                            nRet = m_MyCamera.MV_CC_SetEnumValue_NET("PixelFormat", Convert.ToUInt32(MyCamera.MvGvspPixelType.PixelType_Gvsp_BGR8_Packed));

                            if (MyCamera.MV_OK != nRet)
                            {
                                //m_MyCamera.MV_CC_DestroyDevice_NET();
                                _errMessage = "设置相机:" + Name + " 彩色图像格式失败";
                                return;
                            }

                            break;
                        }
                }
            }


            if (_mManufacturerName == "GEV" ||
                        _mManufacturerName == "Hikvision" ||
                        _mManufacturerName == "Machine Vision" ||
                        _mManufacturerName == "Dahua Technology" ||
                        _mManufacturerName == "Huaray Technology" ||
                        _mManufacturerName == "Teledyne DALSA" ||
                        _mManufacturerName == "Hikrobot" ||
                        _mManufacturerName == "U3V")//海康相机
            {
                nRet = m_MyCamera.MV_CC_SetFloatValue_NET("ExposureTime", (float)_exposureTime);
            }
            else
            {
                nRet = m_MyCamera.MV_CC_SetFloatValue_NET("ExposureTimeAbs", (float)_exposureTime);
            }



            //nRet = m_MyCamera.MV_CC_SetFloatValue_NET("ExposureTimeAbs", (float)_exposureTime);
            if (nRet != MyCamera.MV_OK)
            {
                m_MyCamera.MV_CC_DestroyDevice_NET();
                _errMessage = "设置相机:" + Name + " 曝光失败";
                return;
            }




            nRet = m_MyCamera.MV_CC_SetFloatValue_NET("Gain", (float)_gain);
            if (nRet != MyCamera.MV_OK)
            {
                m_MyCamera.MV_CC_DestroyDevice_NET();
                _errMessage = "设置相机:" + Name + " 增益失败";
                return;
            }

