        private void ImageCallbackFunc(IntPtr pData, ref MyCamera.MV_FRAME_OUT_INFO_EX pFrameInfo, IntPtr pUser)
        {
            //if (!m_bGrabbing)
            //    return;
            //灰度图
            if (pFrameInfo.enPixelType == MyCamera.MvGvspPixelType.PixelType_Gvsp_Mono8)
            {
                InsImage8Grey image = new InsImage8Grey(pFrameInfo.nWidth, pFrameInfo.nHeight);
                IntPtr ImagePtr = image.Scan0;
                //如果内存对齐
                if (image.Width == image.Stride)
                {
                    MemoryOperator.CopyMemory(image.Scan0, pData, image.Width * image.Height);
                }
                else
                {
                    for (int i = 0; i < image.Height; i++)
                    {
                        MemoryOperator.CopyMemory(image.Scan0 + image.Stride * i, pData + image.Width * i, image.Width);
                    }
                }
                EnqueueImage(image);
            }
            else if (pFrameInfo.enPixelType == MyCamera.MvGvspPixelType.PixelType_Gvsp_Mono10 ||
                pFrameInfo.enPixelType == MyCamera.MvGvspPixelType.PixelType_Gvsp_Mono10_Packed ||
                pFrameInfo.enPixelType == MyCamera.MvGvspPixelType.PixelType_Gvsp_Mono12 ||
                pFrameInfo.enPixelType == MyCamera.MvGvspPixelType.PixelType_Gvsp_Mono12_Packed ||
