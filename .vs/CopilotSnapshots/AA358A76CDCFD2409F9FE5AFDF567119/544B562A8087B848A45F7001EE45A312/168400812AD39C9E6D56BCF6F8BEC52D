        public bool TriggerModeOn()
        {
            int nRet = m_MyCamera.MV_CC_SetEnumValue_NET("TriggerMode", (uint)MyCamera.MV_CAM_TRIGGER_MODE.MV_TRIGGER_MODE_ON);
            if (nRet != MyCamera.MV_OK)
            {
                _errMessage = "Failed to set trigger mode to ON.";
                return false;
            }

            //nRet = m_MyCamera.MV_CC_SetEnumValue_NET("AcquisitionMode", 0);
            nRet = m_MyCamera.MV_CC_SetEnumValue_NET("AcquisitionMode", (uint)MyCamera.MV_CAM_ACQUISITION_MODE.MV_ACQ_MODE_CONTINUOUS);

            if (nRet != MyCamera.MV_OK)
            {
                //m_MyCamera.MV_CC_DestroyDevice_NET();
                _errMessage = "Failed to set the acquisition mode to continuous.";
                return false;
            }

            nRet = m_MyCamera.MV_CC_SetEnumValue_NET("TriggerSource", (uint)MyCamera.MV_CAM_TRIGGER_SOURCE.MV_TRIGGER_SOURCE_SOFTWARE);

            if (nRet == 0)
            {
                return true;
            }
            else
            {
                return false;
            }

        }
