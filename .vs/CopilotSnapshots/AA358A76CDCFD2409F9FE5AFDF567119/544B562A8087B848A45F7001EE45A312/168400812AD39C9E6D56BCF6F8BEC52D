        public static int IPAddressCompare(string ip1, string ip2)
        {
            if (string.IsNullOrEmpty(ip1))
            {
                return -1;
            }
            if (string.IsNullOrEmpty(ip2))
            {
                return 1;
            }
            string[] splits1 = ip1.Split(new char[] { '.' });
            string[] splits2 = ip2.Split(new char[] { '.' });
            if (splits1 == null)
            {
                return -1;
            }
            if (splits2 == null)
            {
                return 1;
            }
            if (splits1.Length > splits2.Length)
            {
                return 1;
            }
            if (splits1.Length < splits2.Length)
            {
                return -1;
            }
            for (int i = 0; i < splits1.Length; i++)
            {
                int ret = splits1[i].CompareTo(splits2[i]);
                if (ret != 0)
                {
                    return ret;
                }
            }
            return 0;

        }
        public void ConnectCamera()
        {
            if (null == m_MyCamera)
            {
                m_MyCamera = new MyCamera();
                if (null == m_MyCamera)
                {
                    _errMessage = "Failed to initialize the camera object.";
                    _isConnected = false;
                    return;
                }
            }
            try
            {
                uint ret = MyCamera.MV_CC_GetSDKVersion_NET();
            }
            catch
            {
                m_MyCamera = null;
                System.Windows.Forms.MessageBox.Show(
                        "MVS SDK environment not detected.\n" +
                        "Please ensure that the SDK environment is properly configured.",
                        "Warning",
                        System.Windows.Forms.MessageBoxButtons.OK,
                        System.Windows.Forms.MessageBoxIcon.Warning);

                return;
            }
            
             MyCamera.MV_CC_DEVICE_INFO_LIST m_stDeviceList = new MyCamera.MV_CC_DEVICE_INFO_LIST();

            int nRet = -1;

            try
            {
                nRet = MyCamera.MV_CC_EnumDevices_NET(MyCamera.MV_GIGE_DEVICE | MyCamera.MV_USB_DEVICE, ref m_stDeviceList);
            }
            catch { }

            if (0 != nRet || m_stDeviceList.nDeviceNum == 0)
            {
                _errMessage = "Camera not found (Ethernet or USB).";
            }
            for (int i = 0; i < m_stDeviceList.nDeviceNum; i++)
            {
                MyCamera.MV_CC_DEVICE_INFO device = (MyCamera.MV_CC_DEVICE_INFO)Marshal.PtrToStructure(m_stDeviceList.pDeviceInfo[i], typeof(MyCamera.MV_CC_DEVICE_INFO));

                if (device.nTLayerType == MyCamera.MV_GIGE_DEVICE)//网口相机
                {
                    IntPtr buffer = Marshal.UnsafeAddrOfPinnedArrayElement(device.SpecialInfo.stGigEInfo, 0);
                    MyCamera.MV_GIGE_DEVICE_INFO gigeInfo = (MyCamera.MV_GIGE_DEVICE_INFO)Marshal.PtrToStructure(buffer, typeof(MyCamera.MV_GIGE_DEVICE_INFO));

                    uint nIp1 = ((gigeInfo.nCurrentIp & 0xff000000) >> 24);
                    uint nIp2 = ((gigeInfo.nCurrentIp & 0x00ff0000) >> 16);
                    uint nIp3 = ((gigeInfo.nCurrentIp & 0x0000ff00) >> 8);
                    uint nIp4 = (gigeInfo.nCurrentIp & 0x000000ff);

                    string nIp = nIp1 + "." + nIp2 + "." + nIp3 + "." + nIp4;
                    if (nIp.Trim() == this._ip)
                    {
                        #region 连接网口相机
                        nRet = m_MyCamera.MV_CC_CreateDevice_NET(ref device);
                        if (MyCamera.MV_OK != nRet)
                        {
                            _errMessage = string.Format("Failed to connect to the camera, IP:{0}", this._ip);
                            _isConnected = false;
                            return;
                        }

                        nRet = m_MyCamera.MV_CC_OpenDevice_NET();
                        if (MyCamera.MV_OK != nRet)
                        {
                            m_MyCamera.MV_CC_DestroyDevice_NET();
                            _errMessage = string.Format("Failed to open to the camera, IP:{0}", this._ip);
                            _isConnected = false;
                            return;
                        }

                        int nPacketSize = m_MyCamera.MV_CC_GetOptimalPacketSize_NET();
                        if (nPacketSize > 0)
                        {
                            nRet = m_MyCamera.MV_CC_SetIntValue_NET("GevSCPSPacketSize", (uint)nPacketSize);
                            if (nRet != MyCamera.MV_OK)
                            {
                                m_MyCamera.MV_CC_DestroyDevice_NET();
                                _errMessage = "Failed to write network packet size.";
                                return;
                            }
                        }
                        else
                        {
                            m_MyCamera.MV_CC_DestroyDevice_NET();
                            _errMessage = "Failed to get network packet size.";
                            return;
                        }

                        pCallBackFunc = new MyCamera.cbExceptiondelegate(cbExceptiondelegate);

                        // ch:注册异常回调函数 | en:Register Exception Callback
                        nRet = m_MyCamera.MV_CC_RegisterExceptionCallBack_NET(pCallBackFunc, IntPtr.Zero);
                        if (MyCamera.MV_OK != nRet)
                        {
                            _errMessage = "Failed to register exception callback function.";
                            _isConnected = false;
                        }
                        MyCamera.MVCC_FLOATVALUE pstValue1 = new MyCamera.MVCC_FLOATVALUE();


                        nRet = m_MyCamera.MV_CC_GetFloatValue_NET("ExposureTime", ref pstValue1);

                        // nRet = m_MyCamera.MV_CC_GetFloatValue_NET("ExposureTimeAbs", ref pstValue1);
                        if (nRet != MyCamera.MV_OK)
                        {
                            _errMessage = "Failed to retrieve the camera exposure time.";
                            return;
                        }
                        _exposureTime = pstValue1.fCurValue;

                        nRet = m_MyCamera.MV_CC_GetFloatValue_NET("Gain", ref pstValue1);
                        if (nRet != MyCamera.MV_OK)
                        {
                            _errMessage = "Failed to retrieve the camera gain.";
                            return;
                        }
                        _gain = pstValue1.fCurValue;

                        GC.KeepAlive(pCallBackFunc);
                        _deviceType = InsDeviceType.Camera2DGige;
                        _isConnected = true;

                        break;
                        #endregion
                    }
                    else
                    {
                        _errMessage = "No camera found with the specified IP address.";
                    }
                }
                else if (device.nTLayerType == MyCamera.MV_USB_DEVICE)//USB3.0相机
                {
                    IntPtr buffer = Marshal.UnsafeAddrOfPinnedArrayElement(device.SpecialInfo.stUsb3VInfo, 0);
                    MyCamera.MV_USB3_DEVICE_INFO usbInfo = (MyCamera.MV_USB3_DEVICE_INFO)Marshal.PtrToStructure(buffer, typeof(MyCamera.MV_USB3_DEVICE_INFO));

                    if (usbInfo.chSerialNumber == _serialNumber)
                    {
                        #region 连接USB3.0相机
                        nRet = m_MyCamera.MV_CC_CreateDevice_NET(ref device);
                        if (MyCamera.MV_OK != nRet)
                        {
                            _errMessage = string.Format("Failed to connect to the camera, serialNumber:{0}", this._serialNumber);
                            _isConnected = false;
                            return;
                        }
                        nRet = m_MyCamera.MV_CC_OpenDevice_NET();
                        if (MyCamera.MV_OK != nRet)
                        {
                            m_MyCamera.MV_CC_DestroyDevice_NET();
                            _errMessage = string.Format("Failed to open to the camera, serialNumber:{0}", this._serialNumber);
                            _isConnected = false;
                            return;
                        }
                        pCallBackFunc = new MyCamera.cbExceptiondelegate(cbExceptiondelegate);
                        // ch:注册异常回调函数 | en:Register Exception Callback
                        nRet = m_MyCamera.MV_CC_RegisterExceptionCallBack_NET(pCallBackFunc, IntPtr.Zero);
                        if (MyCamera.MV_OK != nRet)
                        {
                            _errMessage = "Failed to register exception callback function.";
                            _isConnected = false;
                        }
                        GC.KeepAlive(pCallBackFunc);
                        #endregion
                        _deviceType = InsDeviceType.Camera2DUSB;
                        _isConnected = true;
                        break;
                    }
                    else
                    {
                        _errMessage = "No camera found with the specified serial number.";
                    }
                }
            }
        }

        /// <summary>
        /// 相机掉线监控
        /// </summary>
        /// <param name="nMsgType"></param>
        /// <param name="pUser"></param>
        private void cbExceptiondelegate(uint nMsgType, IntPtr pUser)
        {
            if (nMsgType == MyCamera.MV_EXCEPTION_DEV_DISCONNECT)//相机掉线
            {
                _isConnected = false;

                CloseCamera();
                int i = 1;
                while (true)
                {
                    ConnectCamera();
                    if (_isConnected)
                    {
                        SetParams();
                        OpenCamera();
                        //InsMessageManager.GInstance.Warn(string.Format("相机:{0}重连成功", Name, i++));
                        break;
                    }
                    else
                    {
                        //InsMessageManager.GInstance.Alarm(string.Format("相机:{0}掉线 正在尝试第{1}次重连", Name, i++), Insnex.Common.InsErrorCode.Err_Unknown);
                    }
                }
            }
        }
        public void GetParams()
        {
            int nRet = MyCamera.MV_OK;

            MyCamera.MVCC_INTVALUE stParam = new MyCamera.MVCC_INTVALUE();
            nRet = m_MyCamera.MV_CC_GetIntValue_NET("PayloadSize", ref stParam);
            if (MyCamera.MV_OK != nRet)
            {
                _errMessage = "获取相机:" + Name + " 包大小失败";
                return;
            }
            g_nPayloadSize = stParam.nCurValue;

            nRet = m_MyCamera.MV_CC_GetIntValue_NET("Height", ref stParam);
            if (MyCamera.MV_OK != nRet)
            {
                _errMessage = "获取相机:" + Name + " 图像高度失败";
                return;
            }
            nHeight = stParam.nCurValue;

            // ch:获取宽 || en: Get Width
            nRet = m_MyCamera.MV_CC_GetIntValue_NET("Width", ref stParam);
            if (MyCamera.MV_OK != nRet)
            {
                _errMessage = "获取相机:" + Name + " 图像宽度失败";
                return;
            }
            nWidth = stParam.nCurValue;

            MyCamera.MVCC_ENUMVALUE pstValue = new MyCamera.MVCC_ENUMVALUE();
            nRet = m_MyCamera.MV_CC_GetEnumValue_NET("AcquisitionMode", ref pstValue);
            if (nRet != MyCamera.MV_OK)
            {
                _errMessage = "获取相机:" + Name + " 采图模式失败";
                return;
            }
            if (pstValue.nCurValue == 0)
            {
                _acquisitionMode = InsAcquisitionModeEnum.SingleFrame;
            }
            else if (pstValue.nCurValue == 2)
            {
                _acquisitionMode = InsAcquisitionModeEnum.Continuous;
            }

            nRet = m_MyCamera.MV_CC_GetEnumValue_NET("TriggerMode", ref pstValue);
            if (nRet != MyCamera.MV_OK)
            {
                _errMessage = "获取相机:" + Name + " 触发模式开关失败";
                return;
            }
            if (pstValue.nCurValue == 0)
            {
                _isTriggerOn = false;
            }
            else if (pstValue.nCurValue == 1)
            {
                _isTriggerOn = true;
            }

            MyCamera.MVCC_ENUMVALUE triggerModeValue = new MyCamera.MVCC_ENUMVALUE();
            nRet = m_MyCamera.MV_CC_GetEnumValue_NET("TriggerSource", ref triggerModeValue);
            if (MyCamera.MV_OK != nRet)
            {
                _errMessage = "获取相机:" + Name + " 软硬件触发模式失败";
                return;
            }
            //软触发
            if (triggerModeValue.nCurValue == (uint)0)
            {
                triggerMode = Ins2DCamTriggerMode.Software;
            }
            else if (triggerModeValue.nCurValue == (uint)1)
            {
                MyCamera.MVCC_ENUMVALUE triggerSourceValue = new MyCamera.MVCC_ENUMVALUE();
                nRet = m_MyCamera.MV_CC_GetEnumValue_NET("TriggerActivation", ref triggerSourceValue);
                if (MyCamera.MV_OK != nRet)
                {
                    _errMessage = "获取相机:" + Name + " 硬件触发模式失败";
                    return;
                }
                if (triggerSourceValue.nCurValue == (uint)0)
                    triggerMode = Ins2DCamTriggerMode.HardwareRisingEdge;
                else if (triggerSourceValue.nCurValue == (uint)1)
                    triggerMode = Ins2DCamTriggerMode.HardwareFallingEdge;
                else if (triggerSourceValue.nCurValue == (uint)2)
                    triggerMode = Ins2DCamTriggerMode.HardwareLevelHigh;
                else if (triggerSourceValue.nCurValue == (uint)3)
                    triggerMode = Ins2DCamTriggerMode.HardwareLevelLow;
                else if (triggerSourceValue.nCurValue == (uint)4)
                    triggerMode = Ins2DCamTriggerMode.HardwareAnyEdge;
            }



            nRet = m_MyCamera.MV_CC_GetEnumValue_NET("PixelFormat", ref pstValue);
            if (nRet != MyCamera.MV_OK)
            {
                _errMessage = "获取相机:" + Name + " 图像格式失败";
                return;
            }
            if (pstValue.nCurValue == 17301505)
            {
                _imageFormat = InsImageType.Grey8;// InsPixelFormatEnum.Mono8;
            }
            else
            {
                _imageFormat = InsImageType.Color24;// InsPixelFormatEnum.Color;
            }

            MyCamera.MVCC_FLOATVALUE pstValue1 = new MyCamera.MVCC_FLOATVALUE();


            nRet = m_MyCamera.MV_CC_GetFloatValue_NET("ExposureTime", ref pstValue1);

            // nRet = m_MyCamera.MV_CC_GetFloatValue_NET("ExposureTimeAbs", ref pstValue1);
