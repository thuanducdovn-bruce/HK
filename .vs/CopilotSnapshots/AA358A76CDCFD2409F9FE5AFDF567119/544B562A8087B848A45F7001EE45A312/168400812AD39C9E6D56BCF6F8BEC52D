        public IInsImage AcquireOneImage(double exposureTime, double timeoutInMs)
        {
            int nRet;
            
            if (!(triggerMode == Ins2DCamTriggerMode.Software))
            {
                _errMessage = "Not set to software trigger mode.";
                return null;
                // 设置曝光 
                //SetExposureTime(exposureTime);
                //SetGainValue((float)Gain);
            }
            if (OnCamAcqReady != null)
            {
                OnCamAcqReady();
            }
            //m_mutex.WaitOne();
            if (triggerMode == Ins2DCamTriggerMode.Software)
            {
                nRet = m_MyCamera.MV_CC_SetCommandValue_NET("TriggerSoftware");
                if(nRet != MyCamera.MV_OK)
                {
                    _errMessage = string.Format("Failed to execute node 'Softwares', error code: {0}", nRet);
                    return null;
                }

            }

            //获取图像
            DateTime t1 = DateTime.Now;
            TimeSpan timeoutSpan = new TimeSpan(0, 0, 0, 0, (int)timeoutInMs);
            while (_imageList.Count <= 0)
            {
                DateTime t2 = DateTime.Now;
                if (t2 - t1 > timeoutSpan)
                {
                    _errMessage = "Camera image acquisition timed out.";
                    // InsMessageManager.GInstance.Warn("相机:" + Name + " 取图超时");
                    break;
                }
                Thread.Yield();
            }
            if (_imageList.Count <= 0)
            {
                return null;
            }
            IInsImage retImage = _imageList.Dequeue();
            // m_mutex.ReleaseMutex();
            if (OnCamComplete != null)
            {
                OnCamComplete();
            }

            return retImage;
        }
        public IInsImage AcquireOneImage(double exposureTime)
        {
            int nRet;
            if (triggerMode == Ins2DCamTriggerMode.Software)
            {
                // 设置曝光 
                SetExposureTime(exposureTime);
            }
            if (OnCamAcqReady != null)
            {
                OnCamAcqReady();
            }
            //m_mutex.WaitOne();
            if (triggerMode == Ins2DCamTriggerMode.Software)
            {
                int i = m_MyCamera.MV_CC_TriggerSoftwareExecute_NET();
            }

            //获取图像
            while (_imageList.Count <= 0)
            {
                Thread.Yield();
            }
            if (_imageList.Count <= 0)
            {
                return null;
            }
            IInsImage retImage = _imageList.Dequeue();
            //m_mutex.ReleaseMutex();
            if (OnCamComplete != null)
