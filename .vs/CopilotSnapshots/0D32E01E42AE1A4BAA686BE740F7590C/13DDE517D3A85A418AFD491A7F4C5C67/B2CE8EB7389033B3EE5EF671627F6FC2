        public void Initialize(InsToolBlock job, string modelName)
        {
            this.job = job;
            this.modelName = modelName;
        }
        #region Form Event
        private void FormMain_Load(object sender, EventArgs e)
        {
            formRun = new FormRun();
            formSetting = new FormSetting();
            OpenChildForm(formRun);


            string toolBlockModelName = null;
            if (job != null)
            {
                try
                {
                    var terminal = job.Inputs["ModelName"];
                    if (terminal != null)
                    {
                        object modelSettingValue = job.Inputs["ModelName"].Value;
                        toolBlockModelName = modelSettingValue == null ? null : modelSettingValue.ToString();
                    }
                    else
                    {
                        ModelSetting = "inspection";
                    }
                }
                catch
                {
                }
            }

            if (string.IsNullOrWhiteSpace(toolBlockModelName))
            {
                modelName = "inspection";
            }
            else
            {
                ModelSetting = toolBlockModelName;
                if (string.IsNullOrWhiteSpace(modelName))
                    modelName = !string.IsNullOrWhiteSpace(job.Name) ? job.Name : toolBlockModelName;
            }

            lbModelName.Text = modelName;
            lbModelSetting.Text = ModelSetting;

            UpdateUIDevicesConnection();
            UpdateScoreBoard();
            UpdateRunControls();
            clock.Start();
        }

        private void OpenChildForm(Form childForm)
        {
            if (childForm == null || activeForm == childForm)
                return;

            activeForm = childForm;
            childForm.TopLevel = false;
            childForm.FormBorderStyle = FormBorderStyle.None;
            childForm.Dock = DockStyle.Fill;
            tLPChildForm.Controls.Clear();
            tLPChildForm.Controls.Add(childForm);
            childForm.Show();
            childForm.BringToFront();
        }

        private void Clock_Elapsed(object sender, System.Timers.ElapsedEventArgs e)
        {
            if (IsDisposed || !IsHandleCreated)
                return;

            BeginInvoke((MethodInvoker)delegate
            {
                lbDate.Text = DateTime.Now.ToString("yyyy-MM-dd");
                lbTime.Text = DateTime.Now.ToString("HH:mm:ss");
                UpdateUIDevicesConnection();
            });
        }
        private void FormMain_FormClosing(object sender, FormClosingEventArgs e)
        {
            if (isInitializing)
            {
                MessageBox.Show("Wait for initialization to finish before exiting.", "Initializing",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                e.Cancel = true;
                return;
            }

            if (isRunning)
            {
                MessageBox.Show("Stop the system before exiting.", "System running",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                e.Cancel = true;
                return;
            }

            DialogResult confirm = MessageBox.Show("Are you sure you want to exit?", "Exit",
                MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (confirm != DialogResult.Yes)
            {
                e.Cancel = true;
                return;
            }

            clock.Stop();
            if (visionControl != null)
                visionControl.AttachToJobManager(false);
            if (camera != null)
            {
                for (int i = 0; i < camera.mCamera.Length; i++)
                    camera.DestroyCamera(i);
            }

            if (formRun != null)
                formRun.Dispose();
            if (formSetting != null)
                formSetting.Dispose();
        }
        #endregion

        #region Buttons Clicked

        public void OpenModelClick(object sender, EventArgs e)
        {
            if (sender == null)
                return;

            modelName = sender.ToString();
            lbModelName.Text = modelName;
        }

        private void itemSetting_Click(object sender, EventArgs e)
        {
            isHomeView = false;
            OpenChildForm(formSetting);
            UpdateRunControls();
        }

        private void itemHome_Click(object sender, EventArgs e)
        {
            isHomeView = true;
            OpenChildForm(formRun);
            lbModelSetting.Text = ModelSetting ?? string.Empty;
            UpdateScoreBoard();
            UpdateRunControls();
        }

        private void btnReset_Click(object sender, EventArgs e)
        {
            if (isRunning || isInitializing || !isHomeView)
                return;

            DialogResult confirm = MessageBox.Show("Are you sure you want to reset the counters?",
                "Reset counters", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (confirm != DialogResult.Yes)
                return;

            countOK = 0;
            countNG = 0;
            countTotal = 0;
            UpdateScoreBoard();
        }

        private async void btnStart_Click(object sender, EventArgs e)
        {
            if (isRunning || isInitializing)
                return;

            if (isInitialized)
            {
                isRunning = true;
                UpdateRunControls();
                UpdateSystemStatus();
                UpdateSystemProcess();
                return;
            }

            isInitializing = true;
            UpdateRunControls();
            try
            {
                if (job == null)
                    throw new InvalidOperationException("No Insnex program has been loaded.");

                camera = await Task.Run(() => new Camera());
                int connectedCameraCount = 0;
                for (int i = 0; i < camera.mCamera.Length; i++)
                {
                    if (camera.mCamera[i].isConnect)
                        connectedCameraCount++;
                }

                UpdateUIDevicesConnection();
                if (connectedCameraCount != 3)
                    throw new InvalidOperationException(string.Format(
                        "Three cameras are required; {0} connected.", connectedCameraCount));

                toolBlockManager = new List<InsToolBlock> { job };
                visionControl = new VisionControl(ref toolBlockManager);
                visionControl.AttachToJobManager(true);
                isInitialized = true;
                isRunning = true;
                UpdateSystemStatus();
                UpdateSystemProcess();
            }
            catch (Exception ex)
            {
                if (visionControl != null)
                    visionControl.AttachToJobManager(false);
                visionControl = null;
                toolBlockManager = null;

                if (camera != null)
                {
                    for (int i = 0; i < camera.mCamera.Length; i++)
                        camera.DestroyCamera(i);
                    camera = null;
                }

                isInitialized = false;
                isRunning = false;
                UpdateSystemStatus();
                UpdateSystemProcess();
                MessageBox.Show(ex.Message, "Initialization failed", MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
            finally
            {
                isInitializing = false;
                UpdateUIDevicesConnection();
                UpdateRunControls();
            }
        }

        private void btnStop_Click(object sender, EventArgs e)
        {
            isRunning = false;
            if (formRun != null)
                formRun.manualTrigger = false;
            UpdateRunControls();
            UpdateSystemStatus();
            UpdateSystemProcess();
        }

        private void btnTriggerP1_Click(object sender, EventArgs e)
        {
            if (!isRunning || !isInitialized)
                return;

            if (formRun != null)
                formRun.manualTrigger = true;
            TriggerP1?.Invoke();
            TriggerConnectedCamerasOnce();
        }

        private void btnTriggerP2_Click(object sender, EventArgs e)
        {
            if (!isRunning || !isInitialized)
                return;

            if (formRun != null)
                formRun.manualTrigger = true;
            TriggerP2?.Invoke();
            TriggerConnectedCamerasOnce();
        }

        private void TriggerConnectedCamerasOnce()
        {
            if (camera == null)
                return;

            for (int i = 0; i < 3; i++)
            {
                if (GetCamStatus(i))
                    camera.RunOnce(i);
            }
        }

        private void cbLogImages_CheckedChanged(object sender, EventArgs e)
        {
            isLogImages = ckbLogOKImages.Checked;
        }

        private void ckbLogNGImages_CheckedChanged(object sender, EventArgs e)
        {
            isLogNGImages = ckbLogNGImages.Checked;
        }

        private bool GetCamStatus(int camId)
        {
            if (camera == null || camId < 0 || camId >= camera.mCamera.Length || camId >= camConnection.Length)
            {
                if (camId >= 0 && camId < camConnection.Length)
                    camConnection[camId] = false;
                return false;
            }

            camConnection[camId] = camera.mCamera[camId].isConnect;
            return camConnection[camId];
        }

