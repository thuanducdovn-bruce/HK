        #region Update UI

        private void UpdateCameraStatus()
        {
            for (int i = 0; i < 3; i++)
            {
                bool connected = camera != null && i < camera.mCamera.Length && camera.mCamera[i].isConnect;
                Label status = i == 0 ? lbConnectCam1 : i == 1 ? lbConnectCam2 : lbConnectCam3;
                status.Text = string.Format("{0} CAM {1}", connected ? "🟢" : "🔴", i + 1);
                status.ForeColor = connected ? Color.LimeGreen : Color.Red;
            }
        }

        public void UpdateUIDevicesConnection()
        {
            UpdateCameraStatus();
            if (isHomeView && !isRunning)
                UpdateRunControls();
        }

        private void UpdateScoreBoard()
        {
            countTotal = countOK + countNG;
            lbOKCount.Text = countOK.ToString();
            lbNGCount.Text = countNG.ToString();
            lbTotalCount.Text = countTotal.ToString();
        }

        private bool AreCamerasReady()
        {
            if (camera == null)
                return job != null;

            for (int i = 0; i < 3; i++)
            {
                if (i >= camera.mCamera.Length || !camera.mCamera[i].isConnect)
                    return false;
            }

            return true;
        }

        private void EnableControls(bool home, bool ready, bool running)
        {
            btnStart.Enabled = home && ready && !running && !isInitializing;
            btnStart.BackColor = btnStart.Enabled ? Color.Green : Color.Gray;

            btnStop.Enabled = home && running;
            btnStop.BackColor = btnStop.Enabled ? Color.Firebrick : Color.Gray;

            MainMenuStrip.Enabled = !running && !isInitializing;
            btnTriggerP1.Enabled = home && ready && running && isInitialized;
            btnTriggerP2.Enabled = home && ready && running && isInitialized;
            btnReset.Enabled = home && !running && !isInitializing;
        }

        private void UpdateRunControls()
        {
            EnableControls(isHomeView, AreCamerasReady(), isRunning);
        }

        private void UpdateSystemStatus()
        {
            // PLC status writes are intentionally deferred until the PLC register mapping is defined.
            lbStatusERROR.ForeColor = SystemColors.Control;
            lbStatusSTART.ForeColor = isRunning ? Color.LimeGreen : SystemColors.Control;
            lbStatusSTOP.ForeColor = isRunning ? SystemColors.Control : Color.Red;
        }

        public void UpdateSystemProcess()
        {
            // PLC process-state writes are intentionally deferred until the PLC register mapping is defined.
            lbProcessReady.ForeColor = isInitialized ? Color.Yellow : SystemColors.Control;
            lbProcessReadRow1.ForeColor = SystemColors.Control;
            lbProcessBusy1.ForeColor = SystemColors.Control;
            lbProcessComplete1.ForeColor = SystemColors.Control;
            lbProcessReadRow2.ForeColor = SystemColors.Control;
            lbProcessBusy2.ForeColor = SystemColors.Control;
            lbProcessComplete2.ForeColor = SystemColors.Control;
        }

