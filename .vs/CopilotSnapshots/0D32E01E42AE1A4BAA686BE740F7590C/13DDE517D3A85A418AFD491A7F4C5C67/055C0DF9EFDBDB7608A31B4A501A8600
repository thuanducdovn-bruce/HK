        #region Tab Camera
        private void btnLive_Click(object sender, EventArgs e)
        {
            if (btnLive.Text == "LIVE")
            {
                btnLive.BackColor = Color.Red;
                if (cbListCamera.SelectedIndex != -1)
                {
                    _camera.ISLIVE[cbListCamera.SelectedItem.ToString()] = true;
                    try
                    {
                        _camera.SetupRunContinuos(cbListCamera.SelectedIndex);
                        pictureBoxImage.StartLiveDisplay(_camera.mCamera[cbListCamera.SelectedIndex].mAcqFifo);
                    }
                    catch (Exception ex)
                    {

                        MessageBox.Show(ex.ToString());
                    }

                    _utility.SetControlPropertyThreadSafe(btnLive, "Text", "STOP LIVE");
                    SettingTabControl.ItemSize = new Size(0, 32);
                    cbListCamera.Enabled = false;
                    //_mFrmMain.EnabledButton(true, true, false);
                }
                else
                {
                    MessageBox.Show("Please select camera");
                }
            }
            else if (btnLive.Text == "STOP LIVE")
            {
                _camera.ISLIVE[cbListCamera.SelectedItem.ToString()] = false;
                try
                {
                    pictureBoxImage.StopLiveDisplay();
                    //pictureBoxImage.Image = null;
                    if (Convert.ToInt32(tbExposure.Text) > 0 && Convert.ToInt32(tbExposure.Text) < 501)
                    {
                        SetExposureCamera(cbListCamera.SelectedIndex, tbExposure.Text);
                    }
                    else
                    {
                        MessageBox.Show("Exposure Time: 1 => 500");
                    }
                }
                catch (Exception ex)
                {
                    MessageBox.Show(ex.ToString());
                }
                _utility.SetControlPropertyThreadSafe(btnLive, "Text", "LIVE");
                btnLive.BackColor = Color.Gainsboro;
                SettingTabControl.ItemSize = new Size(250, 32);
                pictureBoxImage.Image = null;
                cbListCamera.Enabled = true;
                //_mFrmMain.EnabledButton(true, false, false);
            }
        }

