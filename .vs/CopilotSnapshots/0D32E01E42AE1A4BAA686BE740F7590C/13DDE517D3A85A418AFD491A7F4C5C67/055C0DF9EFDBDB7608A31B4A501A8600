        private void RefreshCameraExposure()
        {
            try
            {
                int i = cbListCamera.SelectedIndex;
                int sequence = cbSequence.SelectedIndex + 1;
                int exp = (int)_loading._toolBlockManager[i].Inputs["Exposure" + sequence.ToString()].Value;
                SetExposureCamera(i, exp.ToString());
                tbExposure.Text = exp.ToString();
            }
            catch (Exception)
            {
                MessageBox.Show("Failed to set camera exposure");
            }
        }

