        #region Supporter
        private bool IsNumberOnly(string str)
        {
            Regex regex = new Regex(@"^\d+$");
            return regex.IsMatch(str);
        }
        private void SetExposureCamera(int index, string value)
        {
            if (IsNumberOnly(value))
                _camera.mCamera[index].mAcqFifo.OwnedExposureParams.Exposure = Convert.ToUInt32(value);
        }
        private void SetExposureReader(int index, string value)
        {
            if (IsNumberOnly(value))
                if (Convert.ToInt32(value) > 5) //min exposure value
                    _dataMan.SetExposure(index, value);
        }
