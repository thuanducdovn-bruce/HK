        #region Tab PLC
        private async void btnWrite_Click(object sender, EventArgs e)
        {
            try
            {
                string input = _plc.GetWriteValueText(tbWriteValue.Text);
                // ushort
                if (input.StartsWith("[") && input.EndsWith("]"))
                {
                    try
                    {
                        ushort[] value = input.ToStringArray<ushort>();

                        //if (isAsync)
                        await _plc.RenderWriteResult(() => _plc.readWriteNet.WriteAsync(tbWriteAdd.Text, value), tbWriteAdd.Text, input);
                        //else
                        //RenderWriteResult(() => readWriteNet.Write(textBox_write_address.Text, value), button_write_ushort, input);
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show("ushort Data is not corrent: " + input + Environment.NewLine + ex.Message);
                    }
                }
                else
                {
                    if (ushort.TryParse(input, out ushort value))
                    {
                        //if (isAsync)
                        await _plc.RenderWriteResult(() => _plc.readWriteNet.WriteAsync(tbWriteAdd.Text, value), tbWriteAdd.Text, input);
                        //else
                        //RenderWriteResult(() => readWriteNet.Write(textBox_write_address.Text, value), button_write_ushort, input);
                    }
                    else
                        MessageBox.Show("ushort Data is not corrent: " + input);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.ToString());
            }
        }

        private async void btnRead_Click(object sender, EventArgs e)
        {
            btnRead.Enabled = false;
            try
            {
                if (tbNumRegister.Text == "1")
                {
                    OperateResult<ushort> read = await _plc.readWriteNet.ReadUInt16Async(tbReadAdd.Text);
                    PLCUtils.ReadResultRender(read, tbReadAdd.Text, tbReadValue);
                }
                else
                {
                    OperateResult<ushort[]> read = await _plc.readWriteNet.ReadUInt16Async(tbReadAdd.Text, ushort.Parse(tbNumRegister.Text));
                    PLCUtils.ReadResultRender(read, tbReadAdd.Text, tbReadValue);
                }
                btnRead.Enabled = true;
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.ToString());
            }
        }
