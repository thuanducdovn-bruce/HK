            private void ChangeDimensionSpec(object sender, int dimNo)// cập nhật dimSpecsArr dựa trên giá trị NumericUpDown
                                                                      // ép kiểu sender thành NumricUpDown
                                                                      // Dự trên Name gắn giá trị vào uplimit, downlimit hoặc offset
            {
                NumericUpDown nud = sender as NumericUpDown;// NumericDown là control nhập số với nút tăng giảm
                string controlName = nud.Name.ToString();
                double controlVal = (double)nud.Value;

                if (controlName == "nudUpLimit")
                {
                    dimSpecsArr[dimNo].UpLimit = controlVal;
                }
                else if (controlName == "nudDownLimit")
                {
                    dimSpecsArr[dimNo].DownLimit = controlVal;
                }
                else if (controlName == "nudOffset")
                {
                    dimSpecsArr[dimNo].Offset = controlVal;
                }
            }
