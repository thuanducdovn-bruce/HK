            private void btnSaveSpecs_Click(object sender, EventArgs e) // lưu thông số từ D1-D6 từ dimSpecsArr vào dimSpecs, cập nhật CogtoolBlock, chạy thử và lưu job
            {
                try
                {
                    for (int k = 1; k <= 6; k++) // duyệt qua từ D1-D6, gắn Uplimit, DownLimit, Offset từ dimSpecsArr vào dimSpecs
                    {
                        dimSpecs["D" + k.ToString() + "UpLimit"] = dimSpecsArr[k - 1].UpLimit;
                        dimSpecs["D" + k.ToString() + "DownLimit"] = dimSpecsArr[k - 1].DownLimit;
                        dimSpecs["D" + k.ToString() + "Offset"] = dimSpecsArr[k - 1].Offset;
                    }
                    checkpoint.Inputs["DimSpecs"].Value = dimSpecs; // cập nhật checkpoint.Input["DimSpecs"] vào dimSpecs
                    checkpoint.Run();// chạy để kiểm tra cấu hình
                    SaveJob(); // đã định nghĩa từ trước để lưu tệp .vpp
                    MessageBox.Show("Specs Updated.\r\nProgram Saved.", "Notify", MessageBoxButtons.OK, MessageBoxIcon.Information);
                }
                catch (Exception ex)
                {
                    MessageBox.Show(ex.ToString(), "Fail to SET Specs", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                }
            }
