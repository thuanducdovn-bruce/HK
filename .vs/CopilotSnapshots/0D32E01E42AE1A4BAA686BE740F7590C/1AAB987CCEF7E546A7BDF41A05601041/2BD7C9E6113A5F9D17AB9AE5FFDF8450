            private async void btnWrite_Click(object sender, EventArgs e)// ghi dữ liệu từ tbWriteValue vào PLC tại địa chỉ trong tbWriteAdd
            {
                try
                {
                    string input = _plc.GetWriteValueText(tbWriteValue.Text); // lấy và xử lí giá trị từ textbox qua phương thức của _plc
