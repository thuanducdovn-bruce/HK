            private void MappingToolBlockExposure(int deviceIndex, string inputName, string val) // gắn giá trị exposure vào hai cogtoolblock tương ứng với chỉ số thiêt bị
            {
                if (IsNumberOnly(val)) // nếu val là số
                {
                    int exp = Convert.ToInt32(val);
                    if (deviceIndex == 0)
                    {
                        _loading._toolBlockManager[0].Inputs[inputName].Value = exp; // gắn cùng giá trị cho cặp toolblock 0-4, input là tập hợp tham số của cogtoolblock dùng để cấu hình exposure
                        _loading._toolBlockManager[4].Inputs[inputName].Value = exp;
                    }
                    else if (deviceIndex == 1)
                    {
                        _loading._toolBlockManager[1].Inputs[inputName].Value = exp;
                        _loading._toolBlockManager[5].Inputs[inputName].Value = exp;
                    }
                    else if (deviceIndex == 2)
                    {
                        _loading._toolBlockManager[2].Inputs[inputName].Value = exp;
                        _loading._toolBlockManager[6].Inputs[inputName].Value = exp;
                    }
                    else if (deviceIndex == 3)
                    {
                        _loading._toolBlockManager[3].Inputs[inputName].Value = exp;
                        _loading._toolBlockManager[7].Inputs[inputName].Value = exp;
                    }
                }
            }

