                                                                                                                                             // HslCommunication là thư viện phổ biến để giao tiếp PLC, readWriteNet là đối tượng chính
                                                                                                                                             // lamda truyền hàm bất đồng bộ vào RenderWriteResult


                            //else
                            //RenderWriteResult(() => readWriteNet.Write(textBox_write_address.Text, value), button_write_ushort, input);
                        }
                        catch (Exception ex)
                        {
                            MessageBox.Show("ushort Data is not corrent: " + input + Environment.NewLine + ex.Message);
                        }
                    }
                    else
                    {
                        if (ushort.TryParse(input, out ushort value)) // thử chuyển chuỗi thành ushort
                        {
                            //if (isAsync)
                            await _plc.RenderWriteResult(() => _plc.readWriteNet.WriteAsync(tbWriteAdd.Text, value), tbWriteAdd.Text, input);// ghi giá trị đơn vào PLC
                                                                                                                                             //else
                                                                                                                                             //RenderWriteResult(() => readWriteNet.Write(textBox_write_address.Text, value), button_write_ushort, input);
                        }
                        else
                            MessageBox.Show("ushort Data is not corrent: " + input);
                    }
                }
                catch (Exception ex)
                {
                    MessageBox.Show(ex.ToString());
                }
            }

            private async void btnRead_Click(object sender, EventArgs e) // đọc dữ liệu từ PLC tại địa chỉ trong tbReadAdd và hiển thị lên tbReadValue
            {
                btnRead.Enabled = false; // vô hiệu hóa nút read
                try
                {
                    if (tbNumRegister.Text == "1")
                    {
                        OperateResult<ushort> read = await _plc.readWriteNet.ReadUInt16Async(tbReadAdd.Text);// nếu chỉ đọc từ một thanh ghi thì độc giá trị ushort từ địa chỉ
                        PLCUtils.ReadResultRender(read, tbReadAdd.Text, tbReadValue); // hiển thị kết quả trạng thái và giá trị lên tbReadValue
                    }
                    else
                    {
                        OperateResult<ushort[]> read = await _plc.readWriteNet.ReadUInt16Async(tbReadAdd.Text, ushort.Parse(tbNumRegister.Text));// đọc mảng ushort
                        PLCUtils.ReadResultRender(read, tbReadAdd.Text, tbReadValue);// hiển thị kết quả( trạng thái và giá trị) lên tbReadValue
                    }
                    btnRead.Enabled = true; // hoàn tất thì bật true lại
                }
                catch (Exception ex)
                {
                    MessageBox.Show(ex.ToString());
                }
            }
