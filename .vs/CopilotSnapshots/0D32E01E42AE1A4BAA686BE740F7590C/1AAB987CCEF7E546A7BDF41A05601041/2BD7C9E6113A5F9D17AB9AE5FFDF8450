            #region Supporter
            private bool IsNumberOnly(string str)// kiểm tra chuỗi str có chứa chỉ số hay k
            {
                Regex regex = new Regex(@"^\d+$");// thể hiện chuỗi phải toàn chỉ số từ 0-9
                return regex.IsMatch(str);// kiểm tra xem có str có khớp với regex k, trả về true nếu chỉ chứa số
            }
            private void SetExposureCamera(int index, string value)// setup thời gian phơi sáng cho cam, index là chỉ số cam cần chỉnh, value là giá trị thời gian phơi sáng
            {
                if (IsNumberOnly(value))// kiểm tra xem value có chí chứa số hay k
                    _camera.mCamera[index].mAcqFifo.OwnedExposureParams.Exposure = Convert.ToUInt32(value);// nếu đúng thì mới cập nhật exposure cho cam[index]
            }
            private void SetExposureReader(int index, string value)// đặt thời gian phơi sáng cho bộ đọc dữ liệu
            {
                if (IsNumberOnly(value))
                    if (Convert.ToInt32(value) > 5) //min exposure value
                        _dataMan.SetExposure(index, value);
            }
            #endregion

